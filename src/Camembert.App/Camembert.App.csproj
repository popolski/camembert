<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Camembert</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Camembert</Product>
    <Description>Analyseur d'espace disque pour Windows</Description>
    <ApplicationIcon>camembert.ico</ApplicationIcon>
    <!-- WPF0001 : ThemeMode (thème Fluent sombre) est encore marqué expérimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="..\Camembert.Core\Camembert.Core.csproj" />
    <ProjectReference Include="..\Camembert.Scanner\Camembert.Scanner.csproj" />
    <ProjectReference Include="..\Camembert.Windows\Camembert.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.156.1" />
  </ItemGroup>

</Project>
