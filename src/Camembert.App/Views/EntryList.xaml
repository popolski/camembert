<UserControl x:Class="Camembert.App.Views.EntryList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext : EntryListViewModel. Liste virtualisée, triable par clic sur un en-tête, sélection multiple Ctrl/Maj. -->
    <ListView x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Extended"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnMouseDoubleClick" KeyDown="OnKeyDown"
              ContextMenuOpening="OnContextMenuOpening">
        <ListView.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="EnterItem" Header="Entrer dans le dossier" Click="OnEnter" />
                <MenuItem x:Name="LocateItem" Header="Afficher dans son dossier" Click="OnLocate" />
                <MenuItem x:Name="PreviewItem" Header="Aperçu" Click="OnPreview" InputGestureText="Espace" />
                <MenuItem x:Name="RevealItem" Header="Ouvrir dans l'Explorateur" Click="OnReveal" />
                <MenuItem Header="Copier le chemin" Click="OnCopyPath" InputGestureText="Ctrl+C" />
                <Separator />
                <MenuItem x:Name="AddToBasketItem" Header="Ajouter au panier" Click="OnAddToBasket" InputGestureText="Suppr" />
                <MenuItem x:Name="RemoveFromBasketItem" Header="Retirer du panier" Click="OnRemoveFromBasket" InputGestureText="Suppr" />
            </ContextMenu>
        </ListView.ContextMenu>
        <ListView.View>
            <GridView>
                <GridViewColumn Width="230">
                    <GridViewColumn.Header>
                        <GridViewColumnHeader Content="{Binding NameHeader}" Command="{Binding SortCommand}" CommandParameter="Name"
                                              HorizontalContentAlignment="Left" ToolTip="Trier par nom" />
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{Binding Color}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="8,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Location}" Visibility="{Binding LocationVisibility}" Foreground="{DynamicResource SecondaryText}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="88">
                    <GridViewColumn.Header>
                        <GridViewColumnHeader Content="{Binding SizeHeader}" Command="{Binding SortCommand}" CommandParameter="Size" ToolTip="Trier par taille" />
                    </GridViewColumn.Header>
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SizeText}" TextAlignment="Right" Width="70" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="%" Width="62">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PercentText}" TextAlignment="Right" Width="44" Foreground="{DynamicResource SecondaryText}" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding TypeText}" />
                <GridViewColumn Width="130" DisplayMemberBinding="{Binding ModifiedText}">
                    <GridViewColumn.Header>
                        <GridViewColumnHeader Content="{Binding ModifiedHeader}" Command="{Binding SortCommand}" CommandParameter="Modified" ToolTip="Trier par date de modification" />
                    </GridViewColumn.Header>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
